<% content_for :title, "Search" %>

<h1>Search</h1>
<p class="lead">
  <% if @search.query.present? %>Results for “<%= @search.query %>” on<% else %>On<% end %>
  <%= search_markets.map(&:display_name).to_sentence %>.
</p>

<div class="panel">
  <%= render "search/results", search: @search %>
</div>
