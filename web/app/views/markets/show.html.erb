<% content_for :title, @market.display_name %>

<div class="page-head">
  <div>
    <p class="eyebrow"><%= @market.region.upcase %> · <%= @market.commodities? ? "Whole region" : "Connected realm" %></p>
    <h1 class="market-title" title="<%= @market.display_name %>"><%= @market.display_name %></h1>
  </div>
  <%= freshness(@listing.latest_taken_at) %>
</div>

<% if market_tabs(@market).many? %>
  <nav class="tabs" aria-label="Markets">
    <% market_tabs(@market).each do |tab| %>
      <%= link_to short_market_name(tab), market_path(tab),
            class: ("is-selected" if tab.id == @market.id),
            "aria-current": ("page" if tab.id == @market.id) %>
    <% end %>
  </nav>
<% end %>

<% if @listing.latest_taken_at.nil? %>
  <div class="empty-state">
    <h2>No snapshot yet</h2>
    <p>This market is not being followed for now, or its first snapshot has not arrived yet.</p>
  </div>
<% else %>
  <%# A filter or a sort only replaces the listing below: no need to work these out for it. %>
  <% unless turbo_frame_request? %>
    <%= render "markets/movers", movers: @movers, market: @market %>
  <% end %>

  <%= form_with url: market_path(@market), method: :get, id: "listing-filters", class: "filters-row",
        role: "search", data: { turbo_frame: "listing", turbo_action: "advance", live_filters: true } do |form| %>
    <div class="field field-grow">
      <%= form.label :q, "Item" %>
      <%= form.search_field :q, value: @listing.query, id: "listing-q", placeholder: "Name or ID", autocomplete: "off" %>
    </div>
    <div class="field">
      <%= form.label :item_class, "Category" %>
      <%= form.select :item_class, options_for_select(@item_classes, @listing.item_class), { include_blank: "All" }, id: "listing-item-class" %>
    </div>
    <div class="field">
      <%= form.label :quality, "Quality" %>
      <%= form.select :quality, options_for_select(ProductsHelper::QUALITIES.map { |key, label| [ label, key ] }, @listing.quality), { include_blank: "All" }, id: "listing-quality" %>
    </div>
    <noscript><%= form.submit "Filter", name: nil %></noscript>
  <% end %>

  <turbo-frame id="listing" data-turbo-action="advance">
    <%= render "markets/listing", listing: @listing, market: @market %>
  </turbo-frame>
<% end %>
