<section class="hero">
  <h1>Le cours de l'hôtel des ventes</h1>
  <p class="lead">Les prix, les tendances et les ventes estimées, relevés environ une fois par heure sur l'API de Blizzard. Choisissez votre royaume : il sera retenu pour vos prochaines visites.</p>
</section>

<% if tracked_markets.empty? %>
  <div class="empty-state">
    <h2>Aucun marché pour l'instant</h2>
    <p>Le fetcher n'a encore rien récupéré. Les marchés apparaîtront ici après son premier cycle.</p>
  </div>
<% else %>
  <% tracked_markets.group_by(&:region).each do |region, markets| %>
    <section class="market-group">
      <h2><%= region.upcase %></h2>
      <ul class="market-grid">
        <% markets.each do |market| %>
          <li>
            <%= link_to market_path(market), class: "market-card" do %>
              <span class="market-card-name" title="<%= market.display_name %>"><%= market.display_name %></span>
              <span class="market-card-meta">
                <%= number_with_delimiter(market.latest_auction_count) %> annonces
              </span>
              <%= freshness(market.latest_taken_at) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
