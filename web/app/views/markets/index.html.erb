<section class="hero">
  <h1>Auction house prices</h1>
  <p class="lead">Prices, trends and estimated sales, collected about once an hour from Blizzard's API. Choose your realm: it will be remembered for your next visits.</p>
</section>

<% if tracked_markets.empty? %>
  <div class="empty-state">
    <h2>No markets yet</h2>
    <p>The fetcher has not collected anything yet. Markets will appear here after its first cycle.</p>
  </div>
<% else %>
  <% tracked_markets.group_by(&:region).each do |region, markets| %>
    <section class="market-group">
      <h2><%= region.upcase %></h2>
      <ul class="market-grid">
        <% markets.each do |market| %>
          <li>
            <%= link_to market_path(market), class: "market-card" do %>
              <span class="market-card-name" title="<%= market.display_name %>"><%= market.display_name %></span>
              <span class="market-card-meta">
                <%= number_with_delimiter(market.latest_auction_count) %> listings
              </span>
              <%= freshness(market.latest_taken_at) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
