<% content_for :title, current_realm.name %>
<% content_for :page_search, true %>

<%= render "realms/head", realm: current_realm, section: :overview %>

<%= render "search/box", realm: current_realm, id: "realm-search", css_class: "page-search", large: true %>

<%# Filled from this browser's history of products opened, if it has one. %>
<div class="recent-strip" data-recent-strip data-items-path="<%= items_base_path(current_realm) %>" hidden>
  <span class="recent-label">Recently viewed</span>
  <div class="recent-items"></div>
  <button type="button" class="recent-clear" data-recent-clear>Clear</button>
</div>

<% if @listing.latest_taken_at.nil? %>
  <div class="empty-state">
    <h2>No prices yet</h2>
    <p>This realm is not being followed for now, or its first snapshot has not arrived yet.</p>
  </div>
<% else %>
  <%# A filter or a sort only replaces the listing below: no need to work these out for it. %>
  <% unless turbo_frame_request? %>
    <%= render "realms/movers", movers: @movers, realm: current_realm %>
  <% end %>

  <h2 class="section-title" id="listing-title">Everything for sale</h2>

  <%= form_with url: realm_home_path(current_realm), method: :get, id: "listing-filters", class: "filters-row",
        role: "search", "aria-labelledby": "listing-title",
        data: { turbo_frame: "listing", turbo_action: "advance", live_filters: true } do |form| %>
    <div class="field field-grow">
      <%= form.label :q, "Filter by name" %>
      <%= form.search_field :q, value: @listing.query, id: "listing-q", placeholder: "Name or item ID", autocomplete: "off" %>
    </div>
    <div class="field">
      <%= form.label :item_class, "Category" %>
      <%= form.select :item_class, options_for_select(@item_classes, @listing.item_class), { include_blank: "All" }, id: "listing-item-class" %>
    </div>
    <div class="field">
      <%= form.label :quality, "Quality" %>
      <%= form.select :quality, options_for_select(ProductsHelper::QUALITIES.map { |key, label| [ label, key ] }, @listing.quality), { include_blank: "All" }, id: "listing-quality" %>
    </div>
    <noscript><%= form.submit "Filter", name: nil %></noscript>
  <% end %>

  <turbo-frame id="listing" data-turbo-action="advance">
    <%= render "realms/listing", listing: @listing, realm: current_realm %>
  </turbo-frame>
<% end %>
