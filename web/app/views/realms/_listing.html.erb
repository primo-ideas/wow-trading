<%# Inside the frame, so that it stays in step with the links that change the sort. %>
<input type="hidden" name="sort" value="<%= listing.sort %>" form="listing-filters">
<input type="hidden" name="dir" value="<%= listing.dir %>" form="listing-filters">

<div class="listing-summary">
  <span>
    <strong><%= number_with_delimiter(listing.total) %></strong>
    <%= "product".pluralize(listing.total) %>
    <%= listing.filtered? ? "found" : "for sale" %>
  </span>
  <% if listing.filtered? %>
    <%= link_to "Clear filters", realm_home_path(realm), class: "link-quiet", data: { turbo_frame: "_top" } %>
  <% end %>
</div>

<% if listing.rows.empty? %>
  <div class="empty-state">
    <h2>No results</h2>
    <p>Nothing for sale on <%= realm.name %> matches these filters. Try another name or category.</p>
  </div>
<% else %>
  <div class="table-wrap">
    <table class="listing">
      <thead>
        <tr>
          <th scope="col"><%= sort_link "Product", "name", listing, realm %></th>
          <th scope="col" class="col-wide"><span data-tip="<%= term(:sparkline) %>" tabindex="0">7 days</span></th>
          <th scope="col" class="number"><%= sort_link "Median", "price", listing, realm, tip: term(:median) %></th>
          <th scope="col" class="number col-medium"><%= sort_link "Minimum", "min", listing, realm, tip: term(:minimum) %></th>
          <th scope="col" class="number"><%= sort_link "24h", "change", listing, realm, tip: term(:change) %></th>
          <th scope="col" class="number col-medium"><%= sort_link "For sale", "quantity", listing, realm, tip: term(:for_sale) %></th>
          <th scope="col" class="number col-wide"><%= sort_link "Sold, 24h", "sold", listing, realm, tip: term(:sold) %></th>
          <th scope="col" class="number col-wide"><%= sort_link "Value, 24h", "value", listing, realm, tip: term(:value) %></th>
        </tr>
      </thead>
      <tbody>
        <% price_units = money_units(listing.rows.map(&:median_price)) %>
        <% min_units = money_units(listing.rows.map(&:min_price)) %>
        <% value_units = money_units(listing.rows.map(&:sold_value)) %>
        <% listing.rows.each do |row| %>
          <tr>
            <td>
              <div class="product-cell">
                <%= product_icon(row.icon_url, row.quality) %>
                <span class="product-label">
                  <%= product_link row, realm, data: { turbo_frame: "_top" } %>
                  <% if row.several_variants? %>
                    <small class="muted"><%= row.variant_count %> variants</small>
                  <% end %>
                </span>
              </div>
            </td>
            <td class="col-wide"><%= sparkline(listing.sparkline(row)) %></td>
            <td class="number"><%= money_cell(row.median_price, units: price_units) %></td>
            <td class="number col-medium"><%= money_cell(row.min_price, units: min_units) %></td>
            <td class="number"><%= change_pill(row.change) %></td>
            <td class="number col-medium"><%= number_with_delimiter(row.quantity) %></td>
            <td class="number col-wide"><%= row.sold_quantity ? number_with_delimiter(row.sold_quantity) : "—" %></td>
            <td class="number col-wide"><%= row.sold_value ? money_cell(row.sold_value, units: value_units) : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="pagination" aria-label="Pages">
    <% if listing.previous_page? %>
      <%= link_to "← Previous", listing_page_path(realm, listing, listing.page - 1) %>
    <% end %>
    <span class="muted">Page <%= number_with_delimiter(listing.page) %> of <%= number_with_delimiter(listing.page_count) %></span>
    <% if listing.next_page? %>
      <%= link_to "Next →", listing_page_path(realm, listing, listing.page + 1) %>
    <% end %>
  </nav>

  <p class="note">
    <%= render "shared/sales_note" %>
    <% if listing.rows.any?(&:several_variants?) %>
      For gear sold in several variants, the median is a quantity-weighted average.
    <% end %>
  </p>
<% end %>
