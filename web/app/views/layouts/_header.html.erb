<header class="site-header">
  <%= link_to root_path, class: "brand" do %>
    <i class="coin coin-g" aria-hidden="true"></i>WoW Trading
  <% end %>

  <% if current_realm %>
    <%= link_to realms_path(item: @item&.id, variant: @variant.presence), class: "realm-button",
          data: { tip: "Change realm" }, "aria-label": "Realm: #{current_realm.name} (#{current_realm.region.upcase}). Change realm" do %>
      <%= realm_label(current_realm) %>
    <% end %>

    <% unless content_for?(:page_search) %>
      <%= render "search/box", realm: current_realm, id: "site-search", css_class: "site-search" %>
    <% end %>
  <% end %>

  <%= link_to watchlist_path, class: "header-link" do %>
    ★ Watchlist<% unless watchlist.empty? %> <small><%= watchlist.size %></small><% end %>
  <% end %>
</header>
