<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "WoW Trading" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="World of Warcraft auction house prices: trends and estimated sales, realm by realm.">
    <meta name="turbo-prefetch" content="false">
    <meta name="turbo-root" content="<%= request.script_name.presence || "/" %>">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0c0f14">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="<%= root_path %>icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "charts", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "interface", defer: true, "data-turbo-track": "reload" %>
  </head>

  <body>
    <%= render "layouts/header" %>
    <main>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <p>Data from the Battle.net API, collected about once an hour. Sales are estimated.</p>
      <p>Not affiliated with Blizzard Entertainment. World of Warcraft is a trademark of Blizzard Entertainment, Inc.</p>
    </footer>
  </body>
</html>
