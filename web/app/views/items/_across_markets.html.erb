<section class="across-markets" aria-labelledby="across-markets-title">
  <h2 id="across-markets-title">On other realms</h2>
  <p class="muted">The <%= across_markets.rows.size %> cheapest of <%= current_realm.region_name %>, at their latest snapshot. Gold cannot leave a region, so other regions are left out.</p>
  <% price_units = money_units(across_markets.rows.map(&:min_price)) %>
  <% median_units = money_units(across_markets.rows.map(&:median_price)) %>
  <div class="table-wrap">
    <table class="listing">
      <thead>
        <tr>
          <th scope="col">Realm</th>
          <th scope="col" class="number"><span data-tip="<%= term(:minimum) %>" tabindex="0">Minimum</span></th>
          <th scope="col" class="number">Compared to <%= current_realm.name %></th>
          <th scope="col" class="number col-medium"><span data-tip="<%= term(:median) %>" tabindex="0">Median</span></th>
          <th scope="col" class="number col-medium"><span data-tip="<%= term(:for_sale) %>" tabindex="0">For sale</span></th>
        </tr>
      </thead>
      <tbody>
        <% across_markets.rows.each do |row| %>
          <% here = across_markets.current?(row) %>
          <% realms = across_markets.realms_of(row) %>
          <% next if realms.empty? %>
          <% others = realms.drop(1) %>
          <tr class="<%= "is-current" if here %>">
            <td>
              <% if here %>
                <%= realms.first.name %>
              <% else %>
                <%= link_to realms.first.name, item_on_realm_path(realms.first, item.id, variant: row.variant_param), class: "product-link" %>
              <% end %>
              <% if others.any? %>
                <small class="muted connected" tabindex="0"
                       data-tip="Shares its auction house with <%= others.map(&:name).to_sentence %>.">+ <%= others.size %></small>
              <% end %>
              <% if here %><small class="muted">your realm</small><% end %>
            </td>
            <td class="number"><%= money_cell(row.min_price, units: price_units) %></td>
            <td class="number"><%= here ? "—" : change_pill(change_between(row.min_price, current_min)) %></td>
            <td class="number col-medium"><%= money_cell(row.median_price, units: median_units) %></td>
            <td class="number col-medium"><%= number_with_delimiter(row.quantity) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
