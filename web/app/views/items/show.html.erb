<% content_for :title, "#{@product.name} · #{current_realm.name}" %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <%= link_to current_realm.name, realm_home_path(current_realm) %>
</nav>

<%# What the browser keeps of this page for "Recently viewed": it never reaches the server. %>
<header class="product-head" data-recent-item="<%= { id: @item.id, variant: @product.series.presence, name: @product.name,
          icon: @product.icon_url.presence, quality: quality_class(@product.quality) }.compact.to_json %>">
  <%= product_icon(@product.icon_url, @product.quality, size: :large) %>
  <div class="product-head-text">
    <h1 class="<%= quality_class(@product.quality) %>"><%= @product.name %></h1>
    <ul class="chips">
      <% [ quality_label(@product.quality), @item.item_class, @item.item_subclass ].compact_blank.uniq.each do |chip| %>
        <li><%= chip %></li>
      <% end %>
      <% if @item.level.to_i.positive? && !@product.pet? %>
        <li>Level <%= @item.level %></li>
      <% end %>
      <li><%= link_to "View on Wowhead ↗", @product.wowhead_url, rel: "noopener noreferrer", target: "_blank" %></li>
    </ul>
  </div>
  <div class="product-head-side">
    <%= freshness(@history.latest_taken_at) %>
    <%= watch_button(@item.id, @product.series) %>
    <%= render "watchlists/target_form", item_id: @item.id, series: @product.series %>
    <% if @listed && watchlist.at_target?(@listed) %>
      <p class="target-hit">At your target: the cheapest is <%= money(@listed.min_price) %></p>
    <% end %>
  </div>
</header>

<turbo-frame id="item-data" data-turbo-action="advance">
  <div class="controls-row">
    <nav class="segmented" aria-label="Period">
      <% ItemHistory::PERIODS.each_key do |period| %>
        <%= link_to period,
              item_on_realm_path(current_realm, @item.id, variant: @variant.presence, period: period),
              class: ("is-selected" if period == @history.period),
              "aria-current": ("true" if period == @history.period) %>
      <% end %>
    </nav>

    <% if @variants.many? && !@product.pet? %>
      <details class="switcher variant-menu" data-menu>
        <summary>
          <span class="switcher-label"><%= variant_label(@variant) || "No variant" %></span>
        </summary>
        <div class="menu-panel">
          <p class="menu-note"><%= @variants.size %> variants for sale, most listed first.</p>
          <ul class="menu-list">
            <% @variants.each do |option| %>
              <li>
                <%= link_to item_on_realm_path(current_realm, @item.id, variant: option.variant, period: @history.period),
                      class: ("is-selected" if option.variant == @variant) do %>
                  <span><%= variant_label(option.variant) || "No variant" %></span>
                  <span class="menu-figure"><%= money(option.min_price) %> · <%= number_with_delimiter(option.quantity) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </details>
    <% end %>

    <%= link_to "Download CSV", item_on_realm_path(current_realm, @item.id, variant: @variant.presence, period: @history.period, format: :csv),
          class: "link-quiet csv-link", data: { turbo: false } %>
  </div>

  <% if @history.prices.empty? %>
    <div class="empty-state">
      <h2>Nothing in this period</h2>
      <p>This item was not for sale on <%= current_realm.name %> during this period. Try a longer one.</p>
    </div>
  <% else %>
    <% current = @history.current %>
    <% if current.nil? %>
      <p class="note">No listings in the latest snapshot: the curves stop at the last time this item was for sale.</p>
    <% end %>

    <section class="summary" aria-label="Summary">
      <div class="summary-main">
        <p class="summary-label"><span data-tip="<%= term(:median) %>" tabindex="0">Median price</span></p>
        <p class="summary-price"><%= money(current&.median_price) %></p>
        <p class="summary-changes">
          <span><%= change_pill(change_between(current&.median_price, @history.reference&.median_price)) %> <span class="muted">over 24h</span></span>
          <span><%= change_pill(change_between(current&.median_price, @history.week_reference&.median_price)) %> <span class="muted">over 7 days</span></span>
        </p>
        <%= render "items/price_range", range: @history.median_range, current: current&.median_price, period: @history.period %>
      </div>
      <dl class="summary-facts">
        <div>
          <dt data-tip="<%= term(:minimum) %>" tabindex="0">Minimum price</dt>
          <dd><%= money(current&.min_price) %></dd>
        </div>
        <div>
          <dt>For sale</dt>
          <dd><%= number_with_delimiter(current&.quantity.to_i) %> <small class="muted" data-tip="<%= term(:listings) %>"><%= number_with_delimiter(current&.auction_count.to_i) %> listings</small></dd>
        </div>
        <div>
          <dt data-tip="<%= term(:sold) %>" tabindex="0">Sold over 24h <small class="muted">estimate</small></dt>
          <dd><%= number_with_delimiter(@history.sold_last_day) %></dd>
        </div>
        <div>
          <dt data-tip="<%= term(:value) %>" tabindex="0">Value sold over 24h <small class="muted">estimate</small></dt>
          <dd><%= money(@history.sold_value_last_day) %></dd>
        </div>
        <div>
          <dt data-tip="<%= term(:usual) %>" tabindex="0">Usual minimum <small class="muted">3 days</small></dt>
          <dd><%= money(@listed&.usual_price) %></dd>
        </div>
        <div>
          <dt data-tip="<%= term(:resale) %>" tabindex="0">Resale at usual minimum <small class="muted">after <%= number_to_percentage(Flip::AUCTION_HOUSE_CUT * 100, precision: 0) %> cut</small></dt>
          <dd><%= @listed&.resale_profit&.positive? ? money(@listed.resale_profit) : "—" %></dd>
        </div>
      </dl>
    </section>

    <%= render "charts/line", chart: price_chart(@history), title: "Unit price",
          description: "Median and minimum at each snapshot", height: "tall" %>

    <div class="chart-pair">
      <%= render "charts/columns", chart: sales_chart(@history), title: "Estimated sales",
            description: @history.period == ItemHistory::HOURLY_SALES_PERIOD ? "Quantity per hour" : "Quantity per day (UTC), the last one is still in progress" %>
      <%= render "charts/line", chart: quantity_chart(@history), title: "Quantity for sale",
            description: "Total at each snapshot", height: "short" %>
    </div>

    <p class="note"><%= render "shared/sales_note" %></p>
  <% end %>
</turbo-frame>

<%= render "items/rhythm", rhythm: @rhythm %>

<% if @across_markets.comparable? %>
  <%= render "items/across_markets", across_markets: @across_markets, item: @item, current_min: @listed&.min_price %>
<% end %>
