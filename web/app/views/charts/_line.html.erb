<figure class="chart" data-chart="line" data-points="<%= chart.points.to_json %>" data-markers="<%= chart.markers.to_json %>">
  <figcaption class="chart-head">
    <div>
      <h2><%= title %></h2>
      <p class="muted"><%= description %></p>
    </div>
    <% if chart.legend? %>
      <ul class="legend">
        <% chart.series.each do |line| %>
          <li><span class="key key-line <%= line.css_class %>"></span><%= line.name %></li>
        <% end %>
        <% if chart.band %>
          <li><span class="key key-area"></span><%= chart.band.name %></li>
        <% end %>
      </ul>
    <% end %>
  </figcaption>

  <div class="plot plot-<%= height %>" tabindex="0" role="img"
       aria-label="<%= title %>. <%= description %>. Flèches gauche et droite pour parcourir les valeurs ; toutes sont aussi dans le tableau sous le graphique.">
    <div class="plot-y" aria-hidden="true">
      <% chart.y_labels.each do |tick| %>
        <span style="top: <%= tick[:y] %>%"><%= tick[:label] %></span>
      <% end %>
    </div>
    <div class="plot-area" data-plot-area>
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <g class="grid">
          <% chart.y_labels.each do |tick| %>
            <line x1="0" x2="100" y1="<%= tick[:y] %>" y2="<%= tick[:y] %>"></line>
          <% end %>
        </g>
        <% if chart.band %>
          <path class="area" d="<%= chart.band_path %>"></path>
        <% end %>
        <% chart.series.reverse_each do |line| %>
          <path class="line <%= line.css_class %>" d="<%= chart.line_path(line.key) %>"></path>
        <% end %>
      </svg>
      <% chart.end_marks.each do |mark| %>
        <i class="end-dot <%= mark[:series].css_class %>" style="left: <%= mark[:x] %>%; top: <%= mark[:y] %>%" aria-hidden="true"></i>
      <% end %>
      <i class="crosshair" hidden></i>
      <div class="chart-tooltip" hidden></div>
    </div>
    <div class="plot-end" aria-hidden="true">
      <% chart.end_marks.each do |mark| %>
        <% if mark[:label] %>
          <span style="top: <%= mark[:y] %>%"><%= mark[:label] %></span>
        <% end %>
      <% end %>
    </div>
    <div class="plot-x" aria-hidden="true">
      <% chart.x_labels.each do |tick| %>
        <span style="left: <%= tick[:x] %>%"><%= tick[:label] %></span>
      <% end %>
    </div>
  </div>

  <%= render "charts/table", chart: chart, title: title %>
</figure>
