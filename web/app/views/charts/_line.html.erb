<figure class="chart" data-chart="line" data-points="<%= chart.points.to_json %>" data-width="<%= ChartFrame::WIDTH %>">
  <figcaption>
    <h2><%= title %></h2>
    <p class="muted"><%= description %></p>
  </figcaption>

  <% if chart.legend? %>
    <ul class="legend">
      <% chart.series.each do |line| %>
        <li><span class="key key-line <%= line.css_class %>"></span><%= line.name %></li>
      <% end %>
      <% if chart.band %>
        <li><span class="key key-area"></span><%= chart.band.name %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="plot">
    <svg viewBox="<%= chart.view_box %>" role="img" tabindex="0"
         aria-label="<%= title %>. <%= description %>. Flèches gauche et droite pour parcourir les valeurs ; toutes sont aussi dans le tableau sous le graphique.">
      <g class="grid">
        <% chart.y_labels.each do |tick| %>
          <line x1="<%= chart.plot_left %>" x2="<%= chart.plot_right %>" y1="<%= tick[:y] %>" y2="<%= tick[:y] %>"></line>
        <% end %>
      </g>
      <g class="axis-labels">
        <% chart.y_labels.each do |tick| %>
          <text x="<%= chart.plot_left - 8 %>" y="<%= tick[:y] + 4 %>" text-anchor="end"><%= tick[:label] %></text>
        <% end %>
        <% chart.x_labels.each do |tick| %>
          <text x="<%= tick[:x] %>" y="<%= chart.plot_bottom + 20 %>" text-anchor="middle"><%= tick[:label] %></text>
        <% end %>
      </g>
      <% if chart.band %>
        <path class="area" d="<%= chart.band_path %>"></path>
      <% end %>
      <% chart.series.reverse_each do |line| %>
        <path class="line <%= line.css_class %>" d="<%= chart.line_path(line.key) %>"></path>
      <% end %>
      <line class="crosshair" y1="<%= chart.plot_top %>" y2="<%= chart.plot_bottom %>" visibility="hidden"></line>
      <% chart.end_marks.each do |mark| %>
        <circle class="end-dot <%= mark[:series].css_class %>" cx="<%= mark[:x] %>" cy="<%= mark[:y] %>" r="5"></circle>
        <% if mark[:label] %>
          <text class="end-label" x="<%= mark[:x] + 12 %>" y="<%= mark[:y] + 4 %>"><%= mark[:label] %></text>
        <% end %>
      <% end %>
    </svg>
    <div class="chart-tooltip" hidden></div>
  </div>

  <%= render "charts/table", chart: chart, title: title %>
</figure>
