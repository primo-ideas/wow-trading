<figure class="chart" data-chart="columns" data-points="<%= chart.points.to_json %>" data-width="<%= ChartFrame::WIDTH %>">
  <figcaption>
    <h2><%= title %></h2>
    <p class="muted"><%= description %></p>
  </figcaption>

  <% if chart.empty? %>
    <p class="empty">Aucune vente estimée sur cette période.</p>
  <% else %>
    <div class="plot">
      <svg viewBox="<%= chart.view_box %>" role="img" tabindex="0"
           aria-label="<%= title %>. <%= description %>. Flèches gauche et droite pour parcourir les valeurs ; toutes sont aussi dans le tableau sous le graphique.">
        <g class="grid">
          <% chart.y_labels.each do |tick| %>
            <line x1="<%= chart.plot_left %>" x2="<%= chart.plot_right %>" y1="<%= tick[:y] %>" y2="<%= tick[:y] %>"></line>
          <% end %>
        </g>
        <g class="axis-labels">
          <% chart.y_labels.each do |tick| %>
            <text x="<%= chart.plot_left - 8 %>" y="<%= tick[:y] + 4 %>" text-anchor="end"><%= tick[:label] %></text>
          <% end %>
          <% chart.x_labels.each do |tick| %>
            <text x="<%= tick[:x] %>" y="<%= chart.plot_bottom + 20 %>" text-anchor="middle"><%= tick[:label] %></text>
          <% end %>
        </g>
        <% chart.columns.each do |column| %>
          <path class="column series-1" d="<%= column[:path] %>" data-index="<%= column[:index] %>"></path>
        <% end %>
      </svg>
      <div class="chart-tooltip" hidden></div>
    </div>

    <%= render "charts/table", chart: chart, title: title %>
  <% end %>
</figure>
