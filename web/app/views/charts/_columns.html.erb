<figure class="chart" data-chart="columns" data-points="<%= chart.points.to_json %>">
  <figcaption class="chart-head">
    <div>
      <h2><%= title %></h2>
      <p class="muted"><%= description %></p>
    </div>
  </figcaption>

  <% if chart.empty? %>
    <p class="muted">No estimated sales in this period.</p>
  <% else %>
    <div class="plot plot-short plot-no-end" tabindex="0" role="img"
         aria-label="<%= title %>. <%= description %>. Left and right arrows move through the values; all of them are also in the table below the chart.">
      <div class="plot-y" aria-hidden="true">
        <% chart.y_labels.each do |tick| %>
          <span style="top: <%= tick[:y] %>%"><%= tick[:label] %></span>
        <% end %>
      </div>
      <div class="plot-area" data-plot-area>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <g class="grid">
            <% chart.y_labels.each do |tick| %>
              <line x1="0" x2="100" y1="<%= tick[:y] %>" y2="<%= tick[:y] %>"></line>
            <% end %>
          </g>
        </svg>
        <div class="bars">
          <% chart.slots.each do |slot| %>
            <div class="bar-slot" data-index="<%= slot[:index] %>">
              <% if slot[:height] %>
                <i class="bar" style="height: <%= slot[:height] %>%"></i>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="chart-tooltip" hidden></div>
      </div>
      <div class="plot-x" aria-hidden="true">
        <% chart.x_labels.each do |tick| %>
          <span style="left: <%= tick[:x] %>%"><%= tick[:label] %></span>
        <% end %>
      </div>
    </div>

    <%= render "charts/table", chart: chart, title: title %>
  <% end %>
</figure>
