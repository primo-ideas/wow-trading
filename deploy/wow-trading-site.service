# The site, listening on localhost only: Caddy faces the outside when there is a domain.
[Unit]
Description=WoW Trading: site
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=wowtrading
Group=wowtrading
WorkingDirectory=/opt/wow-trading/web
EnvironmentFile=/etc/wow-trading/site.env
Environment=RAILS_ENV=production RAILS_MAX_THREADS=3 BUNDLE_DEPLOYMENT=1
ExecStart=/usr/bin/env bundle exec puma -C config/puma.rb
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wow-trading/web/tmp /opt/wow-trading/web/log
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
