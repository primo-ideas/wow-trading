# Copy to .env and fill in. Client created on https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Set by run.ps1. Only needed to run the fetcher by hand.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/wow_market

# What to fetch: eu, eu/hyjal, eu/commodities, or several separated by commas.
# Unset or empty: every realm of every region, which is a lot of data and API calls.
# WOW_SCOPE=eu/commodities

# WOW_LOCALE=fr_FR
# WOW_CONCURRENCY=4
# WOW_ITEM_BATCH=5000
# WOW_HOURLY_RETENTION_DAYS=14
# WOW_POLL_SECONDS=600
