# Copy to .env and fill in. Client created on https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# us, eu, kr or tw
WOW_REGION=eu
WOW_LOCALE=fr_FR

# Empty: commodities only. Otherwise realm slugs (hyjal,archimonde), or all.
# Commodities are always followed. Look at the volume section of the README before using all.
WOW_REALMS=

# WOW_CONCURRENCY=4
# WOW_ITEM_BATCH=500
# WOW_POLL_SECONDS=600
